{
  "name": "kst3/rte-manager",
  "description": "Configure the default TYPO3 rich-text editor (CKEditor) through a dedicated backend module. Manage custom fonts, color palettes, font sizes, SVG icons, CSS styles and element defaults with live previews. Automatically generates the RTE preset and matching frontend CSS, with shared settings across all sites using the default preset.",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Konstantin Stolzenburg",
      "email": "konstantin.stolzenburg@gmail.com",
      "role": "Developer"
    }
  ],
  "keywords": ["typo3", "rte", "ckeditor", "styles", "fonts"],
  "support": {
    "source": "https://github.com/Raigore/rte_manager",
    "issues": "https://github.com/Raigore/rte_manager/issues",
    "email": "konstantin.stolzenburg@gmail.com"
  },
  "autoload": {
    "psr-4": { "Kst3\\RteManager\\": "Classes/" }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "rte_manager",
      "version": "1.0.1",
      "Package": { "providesPackages": {} }
    }
  },
  "require": {
    "php": "^8.2",
    "typo3/cms-backend": "^14.3",
    "typo3/cms-core": "^14.3",
    "typo3/cms-fluid": "^14.3",
    "typo3/cms-rte-ckeditor": "^14.3",
    "symfony/filesystem": "^7.4 || ^8.0",
    "symfony/yaml": "^7.4 || ^8.0"
  }
}
